-- เอฟเฟกต์กดแล้วบุบและขยายสลับกันทุกครั้งที่คลิก
local isIndented = false
local function playDentExpandEffect()
	isIndented = not isIndented
	local dentSize = UDim2.new(0, 48, 0, 48) -- บุบยุบลง
	local expandSize = UDim2.new(0, 70, 0, 70) -- ขยายออก
	local targetSize = isIndented and dentSize or expandSize

	local tweenDown = TweenService:Create(
		circleBtn,
		TweenInfo.new(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = dentSize }
	)
	local tweenTarget = TweenService:Create(
		circleBtn,
		TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = targetSize }
	)

	tweenDown:Play()
	tweenDown.Completed:Connect(function()
		tweenTarget:Play()
	end)
end

-- ลากวงกลมได้ และแยกจากการคลิก
do
	local dragging = false
	local moved = false
	local dragStart, startPos, dragInput

	circleBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = circleBtn.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved then
						playDentExpandEffect()
						-- เปิด/สลับหน้าต่างหลักเมื่อคลิกที่วงกลม
						local selectorWin = screenGui:FindFirstChild("SelectorMenu_Window")
						if selectorWin then
							selectorWin.Visible = not selectorWin.Visible
							if selectorWin.Visible then
								bringToFront(selectorWin)
							end
						end
					end
				end
			end)
		end
	end)

	circleBtn.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	RunService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then
				moved = true
			end
			circleBtn.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

